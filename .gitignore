# 运行环境
.venv/
__pycache__/

# 隐私 / 个人数据（含登录态 SESSDATA，切勿提交）
config.json
download_history.json

# 运行时产物
logs/
downloads/

# 助手工作记忆（与项目无关）
.workbuddy/
.codebuddy/

# 部署环境变量（含访问密码，切勿提交；.env.example 为模板可提交）
.env
.env.*
!.env.example

# 生成的 Caddyfile 运行时产物（由 deploy.sh 从模板生成）
Caddyfile

# 系统 / 编辑器
.DS_Store
Thumbs.db
*.swp
