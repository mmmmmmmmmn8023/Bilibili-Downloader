# ===== 部署配置模板 =====
# 复制为 .env 后填写真实值（真实 .env 已被 .gitignore 排除，不会提交）

# 公网访问域名（需提前将 A 记录解析到本机公网 IP；中国大陆节点须已完成 ICP 备案）
DOMAIN=download.example.com

# Basic Auth 账号密码（公网唯一防线，请务必使用强密码）
AUTH_USER=admin
AUTH_PASS=change_me_to_a_strong_password

# 证书申请邮箱（Let's Encrypt 用于证书过期通知）
ADMIN_EMAIL=admin@example.com
